# TravelGuide Backend Production & Development Environment Variables

# Server Port (Render and cloud hosts automatically assign PORT)
PORT=5000

# Environment Mode: development | production
NODE_ENV=production

# MongoDB Atlas Production Connection URI
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/travelguide?retryWrites=true&w=majority&appName=TravelGuide

# JSON Web Token Secret (Use a strong, cryptographically secure 32+ character string)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_here
JWT_EXPIRES_IN=7d

# Initial Admin Credentials (Seeded when database is empty)
ADMIN_EMAIL=admin@travelguide.com
ADMIN_PASSWORD=YourStrongAdminPassword123!

# Client URL for CORS (Set to your Vercel frontend URL, comma-separated if multiple)
# e.g. CLIENT_URL=https://travelguide-frontend.vercel.app
CLIENT_URL=https://travelguide-frontend.vercel.app

# Set to true if you want the server to run the initial seeder on startup in production
AUTO_SEED=false
